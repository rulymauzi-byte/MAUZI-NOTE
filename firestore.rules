rules_version = '2';
// MAUZI NOTE 5.0 — Reglas de Cloud Firestore.
// Pegar en: Firebase → Firestore Database → Reglas → Publicar.
//
// Igual que la app del maratón: cualquier persona entra con su cuenta de Google,
// sin pedir permiso al administrador. Cada cuenta SOLO puede leer y escribir
// dentro de users/{su uid}/... — nadie puede ver las notas de otro.
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo cuentas reales con correo verificado (no anónimas)
    function conectado() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true;
    }

    // Datos privados de cada cuenta: notas, versiones, partes, categorías, agenda.
    match /users/{uid}/{document=**} {
      allow read, write: if conectado() && request.auth.uid == uid;
    }

    // Todo lo demás queda cerrado.
  }
}
